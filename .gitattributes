# Normalise line endings so Windows checkouts don't break shell scripts or Docker builds
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.zip binary
*.pt binary
*.pth binary
*.onnx binary
*.safetensors binary
*.wav binary
