GNANI_API_KEY=your-gnani-api-key-here
# 1 = greedy decoding (default); higher values use beam search
TRANSLATOR_NUM_BEAMS=1
# Per client IP, per minute: room create and join attempts (each), and paid turns
ROOM_RATE_LIMIT_PER_MINUTE=10
TURN_RATE_LIMIT_PER_MINUTE=10
# Per participant (room + role), per minute: quick replies and delivery-card chip replies together.
# Over the limit the request gets a 429 and the other screen receives nothing.
REPLY_RATE_LIMIT_PER_MINUTE=30
# Most rooms alive at once (in memory)
MAX_ROOMS=50
# Demo recordings only: 1 lets a participant send a prepared clip instead of the microphone.
# Off by default. Clips come from scripts/make_demo_clips.py.
SAATHI_DEMO_INPUT=0
SAATHI_DEMO_CLIPS_DIR=demo/clips
